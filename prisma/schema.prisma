// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// Adicionar -js ao prisma-client para correta geração de client.
// Remover output.
generator client {
  provider = "prisma-client-js"
}

// Depois de garantir versões iguais de prisma e @prisma/client, nada mais falhou aqui.
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum ReservationsStatus {
  PENDING
  APPROVED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  avatar    String?
  hotels     Hotel[]
  reservations Reservation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Hotel {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  address     String
  image       String?
  price       Float
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id])
  reservations Reservation[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
 
  @@map("hotels")
}

model Reservation {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id])
  hotelId Int
  hotel Hotel @relation(fields: [hotelId], references: [id])
  checkIn DateTime
  checkOut DateTime
  total Float
  status ReservationsStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reservations")
}